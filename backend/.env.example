APP_NAME=LexFlow
APP_VERSION=1.0.0

DATABASE_URL=postgresql://user:password@localhost:5432/lexflow

# Required. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GROQ_API_KEY=your_groq_api_key_here
# Groq retires models over time; see the models your key can use at console.groq.com.
LLM_MODEL=openai/gpt-oss-20b
# Your account's tokens-per-minute limit (8000 on Groq's free tier). LexFlow paces its calls to stay under it.
LLM_TOKENS_PER_MINUTE=8000
